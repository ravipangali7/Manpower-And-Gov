# Backend API origin (no trailing slash; paths append /api/…)
VITE_API_URL=https://govapi.luckyuser365.com

# Public frontend origin (canonical, OG, sitemap, absolute URLs)
# Production:
VITE_SITE_URL=https://www.dofe.gov.np
# Staging example:
# VITE_SITE_URL=https://gov.luckyuser365.com

# Optional SEO / analytics
# VITE_GSC_VERIFICATION=
# VITE_GA_ID=
# VITE_PLAUSIBLE_DOMAIN=

# IndexNow (#50): host the key verification file at /{key}.txt on the public site
# (e.g. web/public/{key}.txt). Server INDEXNOW_KEY enables Django post_save pings;
# VITE_INDEXNOW_KEY is an optional client-side fallback — never commit a live key.
# INDEXNOW_KEY=
# VITE_INDEXNOW_KEY=
