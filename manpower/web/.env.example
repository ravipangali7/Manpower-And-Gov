# API base (must include /api)
# Dev (optional — defaults to /api via Vite proxy):
# VITE_API_URL=http://127.0.0.1:8000/api
# Production:
VITE_API_URL=https://manpowerapi.luckyuser365.com/api

# Canonical frontend origin (SEO, og:url, sitemap, absolute URLs)
# Production:
VITE_SITE_URL=https://www.vnvnepal.com
# Staging example:
# VITE_SITE_URL=https://manpower.luckyuser365.com

# Google Search Console site verification (meta content only — do not invent a code)
# VITE_GOOGLE_SITE_VERIFICATION=

# Optional analytics (scripts load only when set)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=www.vnvnepal.com

# IndexNow (#50): host the key verification file at /{key}.txt on the public site
# (e.g. web/public/{key}.txt). Server INDEXNOW_KEY enables Django post_save pings;
# VITE_INDEXNOW_KEY is an optional client-side fallback — never commit a live key.
# VITE_INDEXNOW_KEY=
