# Optional — defaults to /api (proxied to Django in Vite dev)
# VITE_API_URL=http://127.0.0.1:8000/api

# Canonical site origin for SEO (og:url, sitemap, absoluteUrl)
# VITE_SITE_URL=https://www.vnvnepal.com

# Google Search Console site verification (meta content only — do not invent a code)
# VITE_GOOGLE_SITE_VERIFICATION=

# Optional analytics (scripts load only when set)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=www.vnvnepal.com
